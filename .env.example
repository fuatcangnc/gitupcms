# This server's public address and a long random secret (openssl rand -base64 32).
BETTER_AUTH_URL=https://comments.example.com
BETTER_AUTH_SECRET=

# Optional: admin sign-in with GitHub (callback: <BETTER_AUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Commenter sign-in. Set at least one, or add apps per site in Settings → Sign-in.
# Callbacks: <BETTER_AUTH_URL>/api/comments/auth/callback/google and …/callback/github
# (a GitHub OAuth app has one callback, so commenters need a different app from the admin one).
COMMENTS_GOOGLE_CLIENT_ID=
COMMENTS_GOOGLE_CLIENT_SECRET=
COMMENTS_GITHUB_CLIENT_ID=
COMMENTS_GITHUB_CLIENT_SECRET=

# Optional: email notifications (smtps://user:pass@host:465 or smtp://user:pass@host:587).
SMTP_URL=
EMAIL_FROM=Gitupcms <noreply@example.com>

# Where the SQLite database lives (default data/gitupcms.db).
DB_PATH=
